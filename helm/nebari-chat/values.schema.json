{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "properties": {
        "inline": {
          "type": "object"
        }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        }
      }
    },
    "ravnar": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "existingConfigMap": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["kind", "label"],
                "properties": {
                  "kind": { "type": "string", "enum": ["visualization", "sql"] },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "database_url": { "type": "string" },
                  "schema_query": { "type": "string" },
                  "map_popup_prompt": { "type": "string" }
                }
              }
            },
            "mcp_servers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["label", "url"],
                "properties": {
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "url": { "type": "string" },
                  "auth": { "type": "string", "enum": ["none", "impersonate"] },
                  "tool_prefix": { "type": "string" },
                  "timeout": { "type": "number" }
                }
              }
            }
          }
        },
        "nebariapp": {
          "$ref": "#/definitions/nebariapp"
        }
      },
      "required": ["nebariapp"]
    },
    "frontend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"]
            }
          }
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "pod": {
              "type": "object"
            },
            "container": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targetPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "keycloak": {
          "type": "object",
          "properties": {
            "authServerUrl": {
              "type": "string"
            },
            "realm": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "branding": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "logoUrl": {
              "type": "string"
            },
            "logoUrlDark": {
              "type": "string"
            },
            "faviconUrl": {
              "type": "string"
            },
            "theme": {
              "type": "object",
              "properties": {
                "light": {
                  "$ref": "#/definitions/themeTokens"
                },
                "dark": {
                  "$ref": "#/definitions/themeTokens"
                }
              }
            }
          }
        },
        "agentAuthoring": {
          "type": "object",
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "mcp": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "nebariapp": {
          "$ref": "#/definitions/nebariapp"
        }
      }
    }
  },
  "definitions": {
    "themeTokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nebariapp": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
