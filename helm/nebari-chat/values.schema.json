{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "properties": {
        "inline": {
          "type": "object"
        }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        }
      }
    },
    "ravnar": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "existingConfigMap": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "nebariApp": {
          "$ref": "#/definitions/nebariApp"
        }
      },
      "required": ["nebariApp"]
    },
    "frontend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"]
            }
          }
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "pod": {
              "type": "object"
            },
            "container": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targetPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "keycloak": {
          "type": "object",
          "properties": {
            "authServerUrl": {
              "type": "string"
            },
            "realm": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "branding": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "logoUrl": {
              "type": "string"
            },
            "logoUrlDark": {
              "type": "string"
            },
            "faviconUrl": {
              "type": "string"
            },
            "theme": {
              "type": "object",
              "properties": {
                "light": {
                  "$ref": "#/definitions/themeTokens"
                },
                "dark": {
                  "$ref": "#/definitions/themeTokens"
                }
              }
            }
          }
        },
        "nebariApp": {
          "$ref": "#/definitions/nebariApp"
        }
      }
    }
  },
  "definitions": {
    "themeTokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nebariApp": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
